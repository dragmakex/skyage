{
  "name": "skyage",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "packageManager": "bun@1.3.0",
  "dependencies": {
    "@better-auth/expo": "^1.7.11",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-community/datetimepicker": "9.1.0",
    "better-auth": "^1.7.11",
    "expo": "~57.0.28",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-gl": "~57.0.2",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/three": "^0.166.0",
    "babel-preset-expo": "~57.0.0",
    "jest": "~29.7.0",
    "react-dom": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --project server/tsconfig.json",
    "test:server": "bun server/check.ts",
    "server:start": "bun server/index.ts",
    "server:migrate": "bun server/migrate.ts",
    "server:backup": "bun server/backup.ts",
    "lint": "expo lint"
  },
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    },
    "watchman": false
  },
  "patchedDependencies": {
    "three@0.166.1": "patches/three@0.166.1.patch"
  }
}
